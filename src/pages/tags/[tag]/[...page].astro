---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostList from "@/components/PostList.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";
import { breadcrumbNode, collectionPageNode } from "@/utils/structuredData";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
const tagUrl = new URL(`tags/${tag}/`, SITE.website).href;
---

<Layout
  title={`Tag: ${tagName} | ${SITE.title}`}
  structuredData={[
    collectionPageNode(
      `Tag: ${tagName}`,
      new URL(Astro.url.pathname, SITE.website).href,
      page.data,
      `All the articles with the tag "${tagName}".`
    ),
    breadcrumbNode([
      { name: "Home", url: SITE.website },
      { name: "Tags", url: new URL("tags/", SITE.website).href },
      { name: tagName, url: tagUrl },
    ]),
  ]}
>
  <Header />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <PostList ad>
      {page.data.map(data => <Card {...data} showDescription />)}
    </PostList>
  </Main>

  <Pagination {page} />

  <Footer />
</Layout>
