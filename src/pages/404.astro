---
import "@pagefind/default-ui/css/ui.css";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostList from "@/components/PostList.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const recentPosts = getSortedPosts(posts).slice(0, 5);
---

<Layout title={`404 Not Found | ${SITE.title}`} noindex>
  <!--
    Rescue old URLs (BlogEngine /post/..., /talk/..., /category/...) that miss
    the exact-match redirect pages. Runs before Google Analytics loads, so a
    successful redirect doesn't count as a 404 hit.
  -->
  <script is:inline slot="head">
    (function () {
      var path = location.pathname;
      var go = function (to) {
        location.replace(to + location.search + location.hash);
      };
      var aliases = [
        [
          /^\/(page\/about-me|about-me|hire-me|contact)(\.html?|\.aspx)?$/i,
          "/about/",
        ],
        [/^\/talks-presentations\.html?$/i, "/talks-presentations/"],
        [/^\/(search\.aspx|search\.html?)$/i, "/search/"],
        [/^\/(rss\.html?|syndication\.axd|feed)$/i, "/feed.xml"],
        [
          /^\/(archive\/posts-by-year\.html?|archive\/?|\d{4}\/\d{2}\/default\.html?)$/i,
          "/archives/",
        ],
      ];
      for (var i = 0; i < aliases.length; i++) {
        if (aliases[i][0].test(path)) return go(aliases[i][1]);
      }
      var axd = location.search.match(/[?&]file=([^&]+)/);
      if (/^\/file\.axd$/i.test(path) && axd) {
        return location.replace(
          "/files/" +
            decodeURIComponent(axd[1].replace(/\+/g, " ")).replace(/^\/+/, "")
        );
      }
      var tag = path.match(
        /^\/(?:category|archive\/tags)\/([^/]+?)(?:\/default)?(?:\.html?|\.aspx)?$/i
      );
      if (tag)
        return go(
          "/tags/" +
            decodeURIComponent(tag[1])
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "") +
            "/"
        );

      if (!/^\/(post|posts|talk|archive)\//i.test(path)) return;
      var segs = path.split("/").filter(function (s) {
        return s && !/^\d+$/.test(s);
      });
      var slug = segs[segs.length - 1] || "";
      // Must stay in sync with src/utils/redirectKey.ts
      try {
        slug = decodeURIComponent(slug);
      } catch (e) {}
      var key = slug
        .toLowerCase()
        .replace(/\.(aspx|html?).*$/, "")
        .replace(/^\d{4}-\d{2}-\d{2}-/, "")
        .replace(/[^a-z0-9]/g, "");
      if (key.length < 4) return;

      fetch("/redirect-map.json")
        .then(function (r) {
          return r.json();
        })
        .then(function (map) {
          var to = map[key];
          if (!to && key.length >= 15) {
            // Truncated links, e.g. "/post/2008/01/11/Preview-Word-files-(docx"
            var hits = Object.keys(map).filter(function (k) {
              return k.indexOf(key) === 0;
            });
            var uniq = hits
              .map(function (k) {
                return map[k];
              })
              .filter(function (v, i, a) {
                return a.indexOf(v) === i;
              });
            if (uniq.length === 1) to = uniq[0];
          }
          if (to && to !== path) go(to);
        })
        .catch(function () {});
    })();
  </script>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex w-full max-w-app flex-1 flex-col px-4 pt-10 pb-10"
  >
    <div class="mb-10">
      <h1 class="font-mono text-7xl font-bold text-mu sm:text-8xl">404</h1>
      <p class="mt-3 text-base text-fg">
        That page doesn't exist.{" "}
        <a
          href="/"
          class="font-mono text-[13px] font-medium text-ac hover:underline"
        >
          Go home →
        </a>
      </p>
    </div>

    <div class="mb-10">
      <div id="pagefind-search-404"></div>
    </div>

    {
      recentPosts.length > 0 && (
        <section class="!px-0">
          <h2 class="mb-2 font-mono text-xs font-semibold tracking-[0.08em] text-hi uppercase">
            recent
          </h2>
          <PostList>
            {recentPosts.map(post => (
              <Card {...post} />
            ))}
          </PostList>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null = document.querySelector(
      "#pagefind-search-404"
    );

    if (!pageFindSearch) return;

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Display warning in dev mode
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
          <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
            <p><strong>DEV mode Warning!</strong> You need to build the project at least once to see the search results during development.</p>
            <code class="block bg-black text-white px-2 py-1 rounded">npm run build</code>
          </div>
        `;
      }

      new PagefindUI({
        element: "#pagefind-search-404",
        showSubResults: true,
        showImages: false,
      });
    });
  }

  initSearch();
</script>

<style is:global>
  #pagefind-search-404 {
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--ln);
    --pagefind-ui-primary: var(--ac);
    --pagefind-ui-tag: var(--acs);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--fg);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--ln);
    }

    input:focus-visible {
      outline: 1px solid var(--ac);
    }

    .pagefind-ui__result-title a {
      color: var(--ac);
      outline-offset: 1px;
      outline-color: var(--ac);
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
