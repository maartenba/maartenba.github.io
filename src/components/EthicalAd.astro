<script async src="https://media.ethicalads.io/media/client/ethicalads.min.js"
></script>
<div
  class="adaptive-css"
  data-ea-publisher="blog-maartenballiauw-be"
  data-ea-type="text"
>
</div>
<script is:inline>
  // ClientRouter swaps pages without a full reload, so the ad client never
  // sees the new placement. Ask it to fill the placement after navigation.
  // https://ethical-ad-client.readthedocs.io/en/latest/#single-page-apps
  if (!window.__eaReloadBound) {
    window.__eaReloadBound = true;
    // The ad client injects its stylesheet into <head> once. ClientRouter
    // replaces <head> on navigation, which drops it (unstyled ad, visible
    // tracking pixel). Carry those <style> tags over into the incoming page.
    document.addEventListener("astro:before-swap", event => {
      document.head.querySelectorAll("style").forEach(style => {
        const css = style.textContent || "";
        if (css.includes(".ea-") || css.includes("[data-ea-")) {
          event.newDocument.head.appendChild(style.cloneNode(true));
        }
      });
    });
    let firstLoad = true;
    document.addEventListener("astro:page-load", () => {
      if (firstLoad) {
        firstLoad = false; // the client loads the ad itself on a full page load
        return;
      }
      if (window.ethicalads && document.querySelector("[data-ea-publisher]")) {
        window.ethicalads.reload();
      }
    });
  }
</script>
