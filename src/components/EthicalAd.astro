---
interface Props {
  /** Post tags, sent as page-specific keywords for ad targeting. */
  keywords?: string[];
  /** "row" renders as the first row of a post list; default is the in-prose strip. */
  variant?: "strip" | "row";
}

const { keywords = [], variant = "strip" } = Astro.props;
// data-ea-keywords is a pipe-separated list (ethical-ad-client docs).
const eaKeywords = [
  ...new Set(
    keywords
      .map(k =>
        k
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "")
      )
      .filter(k => k && k !== "general")
  ),
]
  .slice(0, 10)
  .join("|");
---

{
  variant === "row" ? (
    <li class="ad-row">
      <span class="ad-row-label" aria-hidden="true">
        sponsor
      </span>
      <div
        class="adaptive-css"
        data-ea-publisher="blog-maartenballiauw-be"
        data-ea-type="text"
        data-ea-keywords={eaKeywords || undefined}
      />
    </li>
  ) : (
    <div class="ad-inline">
      <div
        class="adaptive-css"
        data-ea-publisher="blog-maartenballiauw-be"
        data-ea-type="text"
        data-ea-keywords={eaKeywords || undefined}
      />
    </div>
  )
}
<script is:inline>
  // Load the ad client lazily: when a placement nears the viewport, once.
  (function () {
    if (window.__eaLazyBound) return;
    window.__eaLazyBound = true;
    function load() {
      if (window.__eaLoaded) return;
      window.__eaLoaded = true;
      const s = document.createElement("script");
      s.async = true;
      s.src = "https://media.ethicalads.io/media/client/ethicalads.min.js";
      document.head.appendChild(s);
    }
    function init() {
      const els = document.querySelectorAll("[data-ea-publisher]");
      if (!els.length) return;
      if (!("IntersectionObserver" in window)) {
        load();
        return;
      }
      const io = new IntersectionObserver(
        function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: "300px" }
      );
      els.forEach(function (el) { io.observe(el); });
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>
