---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const link = "text-ac hover:underline";
const off = "text-mu opacity-50 select-none";
---

{
  page.lastPage > 1 && (
    <nav
      class="mx-auto mt-5 mb-8 flex w-full max-w-app items-center gap-5 px-4 font-mono text-[13px] font-medium"
      aria-label="Pagination"
    >
      {page.url.prev ? (
        <a href={page.url.prev} class={link} aria-label="Previous">
          ← prev
        </a>
      ) : (
        <span class={off} aria-disabled="true">
          ← prev
        </span>
      )}
      <span class="text-mu">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class={link} aria-label="Next">
          next →
        </a>
      ) : (
        <span class={off} aria-disabled="true">
          next →
        </span>
      )}
    </nav>
  )
}
