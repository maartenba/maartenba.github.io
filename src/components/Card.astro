---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import type { CollectionEntry } from "astro:content";
import { getPostHref } from "@/utils/getPath";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export type Props = CollectionEntry<"blog"> & { showDescription?: boolean };

const { data, id, filePath, showDescription = false } = Astro.props;
const {
  title,
  description,
  descriptionGenerated,
  pubDatetime,
  modDatetime,
  timezone: tz,
} = data;
const desc = showDescription && !descriptionGenerated ? description : undefined;
const modified = modDatetime && modDatetime > pubDatetime;
const date = dayjs(modified ? modDatetime : pubDatetime)
  .tz(tz || SITE.timezone)
  .format("MMM D, YYYY");
---

<li class="border-b border-ln last:border-0">
  <a
    href={getPostHref(id, filePath)}
    class="group grid gap-x-4 py-3 no-underline sm:grid-cols-[110px_1fr]"
  >
    <time
      datetime={new Date(pubDatetime).toISOString()}
      class="pt-[3px] font-mono text-[13px] text-mu"
    >
      {date}
    </time>
    <span class="min-w-0">
      <span
        class="block text-base leading-[1.35] font-semibold text-hi group-hover:text-ac"
      >
        {title}
      </span>
      {
        desc && (
          <span class="mt-[3px] line-clamp-2 block text-[14.5px] text-mu">
            {desc}
          </span>
        )
      }
    </span>
  </a>
</li>
