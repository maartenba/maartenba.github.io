---
import { Image } from "astro:assets";
import avatar from "@/assets/images/avatar.jpg";
import { SITE } from "@/config";

export interface Props {
  variant?: "home" | "compact";
}

const { variant = "compact" } = Astro.props;
const home = variant === "home";

const { pathname } = Astro.url;
const first = pathname.split("/").filter(Boolean)[0];

const links = [
  { label: "posts", href: "/posts/", key: "posts" },
  { label: "talks", href: "/talks-presentations/", key: "talks-presentations" },
  { label: "about", href: "/about/", key: "about" },
  { label: "rss", href: "/feed.xml", key: "feed.xml" },
  { label: "search", href: "/search/", key: "search" },
];
---

<header class="mx-auto w-full max-w-app px-4 pt-8 pb-2 sm:pt-11">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-bg px-3 py-2 text-ac transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <a
      href="/"
      class:list={["flex items-center", home ? "gap-5" : "gap-3.5"]}
      aria-label={SITE.author}
    >
      <Image
        src={avatar}
        alt=""
        width={home ? 72 : 40}
        height={home ? 72 : 40}
        densities={[1, 2]}
        format="webp"
        fetchpriority={home ? "high" : undefined}
        loading={home ? "eager" : undefined}
        class:list={[
          "shrink-0 object-cover outline-1 outline-ln",
          home
            ? "size-[72px] rounded-[10px] outline-offset-4"
            : "size-10 rounded-lg outline-offset-3",
        ]}
      />
      {
        home ? null : (
          <span class="text-[17px] font-bold text-hi">{SITE.author}</span>
        )
      }
    </a>
    {
      home && (
        <div class="min-w-0">
          <h1 class="text-[26px] leading-tight font-bold text-hi">
            {SITE.author}
          </h1>
          <p class="mt-px text-mu">{SITE.bio}</p>
        </div>
      )
    }
    <nav
      aria-label="Main"
      class="flex w-full flex-wrap items-center gap-x-[18px] gap-y-1 font-mono text-[13px] text-mu sm:ms-auto sm:w-auto"
    >
      {
        links.map(l => (
          <a
            href={l.href}
            aria-current={first === l.key ? "page" : undefined}
            class="inline-flex min-h-6 items-center hover:text-hi aria-[current=page]:font-semibold aria-[current=page]:text-hi"
          >
            {l.label}
          </a>
        ))
      }
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="inline-flex min-h-6 items-center font-mono text-[13px] hover:text-hi"
            aria-label="auto"
          >
            <span data-theme-label>◐ dark</span>
          </button>
        )
      }
    </nav>
  </div>
</header>
