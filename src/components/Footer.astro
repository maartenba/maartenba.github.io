---
import { SOCIALS } from "@/constants";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full max-w-app px-4", { "mt-auto": !noMarginTop }]}>
  <p
    class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-ln py-6 font-mono text-xs text-mu"
  >
    <span>© 2006–{currentYear} Maarten Balliauw</span>
    {
      SOCIALS.map(s => (
        <a
          href={s.href}
          rel="me noopener"
          class="inline-flex min-h-6 items-center hover:text-hi"
        >
          {s.name.toLowerCase()}
        </a>
      ))
    }
  </p>
</footer>
