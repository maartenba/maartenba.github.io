---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import Toc from "@/components/Toc.astro";
import AuthorCard from "@/components/AuthorCard.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezonePlugin from "dayjs/plugin/timezone";
import avatar from "@/assets/images/avatar.jpg";
import { Image } from "astro:assets";
import { getPath, getPostHref } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import EthicalAd from "@/components/EthicalAd.astro";
import { getRelatedPosts } from "@/utils/getRelatedPosts";
import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  descriptionGenerated,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

dayjs.extend(utc);
dayjs.extend(timezonePlugin);

const { Content, headings, remarkPluginFrontmatter } = await render(post);
const minutesRead: number | undefined = remarkPluginFrontmatter?.minutesRead;

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  ogType: "article",
  tags,
  ogImageGenerated: !!ogImageUrl && ogImageUrl.endsWith("/index.png"),
};

const relatedPosts = getRelatedPosts(post, posts, 3);

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex < allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;

const fmt = (d: Date) =>
  dayjs(d)
    .tz(timezone || SITE.timezone)
    .format("MMM D, YYYY");
const published = fmt(pubDatetime);
const updated =
  modDatetime && modDatetime > pubDatetime ? fmt(modDatetime) : undefined;
const mainTag = tags.find(t => t.toLowerCase() !== "general") ?? tags[0];

const postPath = getPostHref(post.id, post.filePath);
const postUrl = new URL(postPath, SITE.website).href;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.website },
    {
      "@type": "ListItem",
      position: 2,
      name: "Posts",
      item: new URL("posts/", SITE.website).href,
    },
    { "@type": "ListItem", position: 3, name: title, item: postUrl },
  ],
};
---

<Layout {...layoutProps}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbData)}
    />
  </Fragment>
  <Header />
  <BackButton />
  <main id="main-content" class="post-wrap">
    <div class="post-article">
      <header class="post-head">
        <div class="post-crumb">
          {
            mainTag && (
              <a href={`/tags/${slugifyStr(mainTag)}/`} class="post-pill">
                {mainTag}
              </a>
            )
          }
          <time datetime={dayjs(pubDatetime).toISOString()}>{published}</time>
          {
            minutesRead && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{minutesRead} min read</span>
              </>
            )
          }
        </div>
        <h1>{title}</h1>
        {
          descriptionGenerated !== true && description && (
            <p class="post-dek">{description}</p>
          )
        }
        <div class="post-by">
          <Image
            src={avatar}
            alt=""
            width={28}
            height={28}
            loading="eager"
            class="post-by-avatar"
          />
          <span>
            <a href="/about/" rel="author">{author}</a>
            <EditPost
              {hideEditPost}
              {post}
              variant="link"
              class="post-by-edit"
            />
          </span>
        </div>
      </header>

      <div class="post-body">
        <article id="article" class="app-prose" data-pagefind-body>
          <div data-pagefind-ignore><EthicalAd keywords={tags} /></div>
          <Content />
        </article>
        <Toc {headings} {post} {tags} {published} {updated} />
      </div>
    </div>

    <nav
      data-pagefind-ignore
      aria-label="Previous and next posts"
      class="post-end"
    >
      {
        prevPost ? (
          <a href={getPostHref(prevPost.id, prevPost.filePath)} class="post-nx">
            <small>&larr; previous</small>
            <span>{prevPost.title}</span>
          </a>
        ) : (
          <span class="post-nx-empty" />
        )
      }
      {
        nextPost && (
          <a
            href={getPostHref(nextPost.id, nextPost.filePath)}
            class="post-nx post-nx-r"
          >
            <small>next &rarr;</small>
            <span>{nextPost.title}</span>
          </a>
        )
      }
    </nav>

    <AuthorCard />

    {
      relatedPosts.length > 0 && (
        <div
          data-pagefind-ignore
          class="post-box"
          role="region"
          aria-labelledby="related-posts"
        >
          <h2 id="related-posts" class="post-box-label">
            Related posts
          </h2>
          <ul class="post-related">
            {relatedPosts.map(related => (
              <li>
                <a href={getPostHref(related.id, related.filePath)}>
                  {related.data.title}
                </a>
                <time
                  datetime={new Date(related.data.pubDatetime).toISOString()}
                >
                  {new Date(related.data.pubDatetime).toLocaleDateString(
                    "en-GB",
                    {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                      timeZone: "UTC",
                    }
                  )}
                </time>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div data-pagefind-ignore class="post-box post-share">
      <ShareLinks />
      <a
        href="https://www.google.com/preferences/source?q=blog.maartenballiauw.be"
        target="_blank"
        rel="noopener noreferrer"
        title="Add blog.maartenballiauw.be as a preferred source on Google"
        aria-label="Prefer this blog on Google: add blog.maartenballiauw.be as a preferred source"
        class="post-prefer"
      >
        &#9733; Prefer this blog on Google
      </a>
    </div>

    <div id="giscus-container" class="mt-10"></div>
    <script is:inline>
      (function () {
        const el = document.getElementById("giscus-container");
        if (!el) return;
        let loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          const s = document.createElement("script");
          s.src = "https://giscus.app/client.js";
          s.async = true;
          s.crossOrigin = "anonymous";
          const attrs = {
      "data-repo": "maartenba/maartenba.github.io",
      "data-repo-id": "MDEwOlJlcG9zaXRvcnk2NDcxNDE5Mw==",
      "data-category": "General",
      "data-category-id": "DIC_kwDOA9t10c4CyCS_",
      "data-mapping": "url",
      "data-strict": "0",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-theme": "preferred_color_scheme",
      "data-lang": "en",
      "data-loading": "lazy",
    };
          for (const k in attrs) s.setAttribute(k, attrs[k]);
          el.appendChild(s);
        }
        if ("IntersectionObserver" in window) {
          new IntersectionObserver(
            function (entries, obs) {
              if (entries.some(function (e) { return e.isIntersecting; })) {
                obs.disconnect();
                load();
              }
            },
            { rootMargin: "400px" }
          ).observe(el);
        } else {
          window.addEventListener("load", load);
        }
      })();
    </script>
  </main>
  <Footer />
</Layout>

<script is:inline>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      )
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute(
        "aria-label",
        "Link to section: " + heading.textContent
      );

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** One delegated listener */
  document.addEventListener("click", async e => {
    const btn = e.target.closest?.(".code .copy");
    if (!btn) return;
    const text = btn.closest(".code")?.querySelector("pre code")?.innerText;
    await navigator.clipboard.writeText(text ?? "");
    btn.textContent = "copied";
    setTimeout(() => (btn.textContent = "copy"), 1500);
  });
</script>
