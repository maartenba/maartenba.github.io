---
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<Breadcrumb />
<main
  data-backUrl={backUrl}
  id="main-content"
  class="mx-auto w-full max-w-app px-4 pb-6"
>
  <h1
    class="mt-5 text-[26px] leading-tight font-bold tracking-[-0.015em] text-hi sm:text-[32px]"
  >
    {
      "titleTransition" in props ? (
        <>
          {props.pageTitle[0]}{" "}
          <span>
            {props.pageTitle[1]}
          </span>
        </>
      ) : (
        props.pageTitle
      )
    }
  </h1>
  {
    props.pageDesc && (
      <p class="mt-2 mb-6 text-base text-mu">{props.pageDesc}</p>
    )
  }
  {!props.pageDesc && <div class="mb-6" />}
  <slot />
</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
