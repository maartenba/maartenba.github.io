---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EditPost from "@/components/EditPost.astro";
import EthicalAd from "@/components/EthicalAd.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

// Derive the source file path from the current URL
// e.g., /about -> src/pages/about.md, /talks-presentations -> src/pages/talks-presentations.md
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "");
const filePath = `src/pages/${slug}.md`;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <div class="mx-auto w-full max-w-app px-4">
      <h1
        class="mt-5 mb-6 text-[26px] leading-tight font-bold tracking-[-0.015em] text-hi sm:text-[32px]"
      >
        {frontmatter.title}
      </h1>
      <section
        id="about"
        class="app-prose mb-12 max-w-none rounded-lg border border-ln bg-card px-[22px] py-6 shadow-[0_1px_2px_#0000000d] sm:px-[30px] prose-img:border-0"
      >
        <EthicalAd />
        <slot />
        <EditPost filePath={filePath} class="mt-8" />
      </section>
    </div>
  </main>
  <Footer />
</Layout>
