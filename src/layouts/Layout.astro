---
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import sans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import sans700 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url";
import {
  PERSON_ID,
  WEBSITE_ID,
  personNode,
  websiteNode,
  type JsonLd,
} from "@/utils/structuredData";
import "@/styles/fonts.css";
import "@/styles/global.css";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  ogType?: string;
  /** Set to true to emit `noindex, nofollow` instead of the default robots meta */
  noindex?: boolean;
  /** Tags of the article (emitted as article:tag) */
  tags?: string[];
  /** Whether the og image is known to be 1200x630 (generated OG images are) */
  ogImageGenerated?: boolean;
  /** Word count of the article (BlogPosting.wordCount) */
  wordCount?: number;
  /** Article headline (BlogPosting.headline); defaults to title */
  headline?: string;
  /** Extra page-specific JSON-LD nodes, merged into the @graph */
  structuredData?: JsonLd[];
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  ogType = "website",
  noindex = false,
  tags = [],
  ogImageGenerated,
  wordCount,
  headline,
  structuredData = [],
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// Default site OG image and dynamically generated post OG images are 1200x630
// (see src/utils/og-templates); custom/remote images have unknown dimensions.
const knownOgSize = ogImageGenerated ?? !Astro.props.ogImage;

const postNode: JsonLd | null = pubDatetime
  ? {
      "@type": "BlogPosting",
      "@id": `${canonicalURL}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": `${canonicalURL}` },
      headline: headline ?? title,
      description,
      image: knownOgSize
        ? {
            "@type": "ImageObject",
            url: `${socialImageURL}`,
            width: 1200,
            height: 630,
          }
        : `${socialImageURL}`,
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: { "@id": PERSON_ID },
      publisher: { "@id": PERSON_ID },
      isPartOf: { "@id": WEBSITE_ID },
      inLanguage: SITE.lang,
      ...(tags.length && { keywords: tags.join(", ") }),
      ...(wordCount && { wordCount }),
    }
  : null;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    personNode(),
    websiteNode(),
    ...(postNode ? [postNode] : []),
    ...structuredData,
  ],
};
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sans400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sans700}
      crossorigin
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    {
      knownOgSize && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />
    {pubDatetime && <meta property="article:author" content={author} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    />

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag.js requires the arguments object, not a rest array
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-3H6PHFSRVX");
      // Load Google Analytics after the page has loaded and the browser is idle
      (function () {
        let loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-3H6PHFSRVX";
          document.head.appendChild(s);
        }
        function schedule() {
          if ("requestIdleCallback" in window)
            requestIdleCallback(load, { timeout: 4000 });
          else setTimeout(load, 3000);
        }
        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule);
      })();
    </script>

    <slot name="head" />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("feed.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
